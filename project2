/* Global styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Inter", "Segoe UI", sans-serif;
  background: #f4f5fb;
  color: #171923;
  min-height: 100vh;
  padding: 40px 20px;
}

/* Main container */
.todo-container {
  width: 100%;
  max-width: 650px;
  margin: 0 auto;
  background: #ffffff;
  padding: 32px;
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(35, 35, 75, 0.08);
}

/* Heading */
.todo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}

.todo-header h1 {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.8px;
}

.todo-header p {
  color: #85879a;
  font-size: 14px;
  margin-top: 6px;
}

/* Task input */
.todo-input {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
}

.todo-input input {
  flex: 1;
  min-width: 0;
  padding: 14px 16px;
  border: 1px solid #e5e7ef;
  border-radius: 12px;
  font-size: 15px;
  outline: none;
  transition: 0.2s ease;
}

.todo-input input:focus {
  border-color: #6c63ff;
  box-shadow: 0 0 0 3px rgba(108, 99, 255, 0.12);
}

/* Buttons */
button {
  border: none;
  cursor: pointer;
  font: inherit;
  transition: 0.2s ease;
}

.add-btn {
  background: #6c63ff;
  color: #fff;
  padding: 14px 22px;
  border-radius: 12px;
  font-weight: 600;
}

.add-btn:hover {
  background: #574de5;
  transform: translateY(-1px);
}

/* Task list */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  background: #fafaff;
  border: 1px solid #eeeef5;
  border-radius: 14px;
  transition: 0.2s ease;
}

.task-item:hover {
  background: #fff;
  border-color: #d9d5ff;
  transform: translateY(-2px);
  box-shadow: 0 5px 18px rgba(35, 35, 75, 0.06);
}

/* Custom checkbox */
.task-item input[type="checkbox"] {
  width: 19px;
  height: 19px;
  accent-color: #6c63ff;
  cursor: pointer;
  flex-shrink: 0;
}

/* Task text */
.task-text {
  flex: 1;
  font-size: 15px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.task-item.completed .task-text {
  color: #a0a1ae;
  text-decoration: line-through;
}

/* Priority badges */
.priority {
  padding: 5px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
}

.priority.high {
  background: #fff0ed;
  color: #e4573d;
}

.priority.medium {
  background: #fff6df;
  color: #a66b00;
}

.priority.low {
  background: #eaf8f1;
  color: #198754;
}

/* Delete button */
.delete-btn {
  background: transparent;
  color: #a0a1ae;
  font-size: 20px;
  padding: 4px 8px;
  border-radius: 8px;
}

.delete-btn:hover {
  background: #fff0ed;
  color: #e4573d;
}

/* Mobile responsive */
@media (max-width: 480px) {
  body {
    padding: 20px 12px;
  }

  .todo-container {
    padding: 22px 16px;
    border-radius: 16px;
  }

  .todo-header h1 {
    font-size: 24px;
  }

  .todo-input {
    flex-direction: column;
  }

  .add-btn {
    width: 100%;
  }

  .task-item {
    padding: 14px 12px;
    gap: 10px;
  }
}